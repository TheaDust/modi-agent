<mxCell id="c1" value="记账库可修改性重构：架构 A（重构前） → 架构 B（重构后）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1240" height="42" as="geometry" /></mxCell>
<mxCell id="c2" value="架构 A（重构前）：同一条业务规则，两个后端各写一遍" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=2;verticalAlign=top;align=left;spacingTop=12;spacingLeft=16;fontSize=17;fontStyle=1;fontColor=#922B21;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="560" height="752" as="geometry" /></mxCell>
<mxCell id="c3" value="架构 B（重构后）：规则只有一处，后端只剩存储原语" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#EAF7EF;strokeColor=#1E8449;strokeWidth=2;verticalAlign=top;align=left;spacingTop=12;spacingLeft=16;fontSize=17;fontStyle=1;fontColor=#145A32;" vertex="1" parent="1"><mxGeometry x="690" y="76" width="560" height="752" as="geometry" /></mxCell>
