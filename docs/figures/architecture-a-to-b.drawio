<mxCell id="c16" value="两个后端都依赖同一套 dao 接口，业务规则却各写了一遍 —— 规则与存储实现混在同一层" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2F3F4;strokeColor=#5D6D7E;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontColor=#212F3D;" vertex="1" parent="1"><mxGeometry x="62" y="546" width="476" height="52" as="geometry" /></mxCell>
