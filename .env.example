# 复用本机已有 SDK；路径可相对于本仓库，也可使用绝对路径。
PI_SDK_PATH=../ShallowCode/node_modules/@earendil-works/pi-coding-agent

# openai-completions 对应兼容 OpenAI 的 /chat/completions 接口。
# 其他支持的协议：anthropic-messages、openai-responses。
LLM_API=openai-completions
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 上下文窗口：必须与模型真实能力一致。声明过小会让 SDK 在上下文接近上限时
# 把单次输出上限压到接近 0，运行以 "Model stopped: length" 失败。
LLM_CONTEXT_WINDOW=512000
# 单次输出上限，同时也是思考 token 与正文共享的池子；必须小于上下文窗口。
LLM_MAX_OUTPUT_TOKENS=32768
LLM_TEMPERATURE=0
# 思考档位：off 表示关闭思考（发给服务商的是 reasoning_effort=none），其余档位原样透传。
LLM_THINKING_LEVEL=medium

# 每次运行的货币成本按下列单价估算：美元 / 百万 token。
MODEL_COST_INPUT=0.15
MODEL_COST_OUTPUT=0.6
MODEL_COST_CACHE_READ=0.003
# 可选；未填写时按输入单价计。
# MODEL_COST_CACHE_WRITE=0.15

# 独立验收使用本机 Maven；未填写时使用 PATH 中的 mvn（Windows 为 mvn.cmd）。
# MAVEN_PATH=D:\Tools\apache-maven-3.9.14\bin\mvn.cmd
# 事后守卫使用 Python；未填写时使用 PATH 中的 python。
# PYTHON=python
