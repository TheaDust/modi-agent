# 复用本机已有 SDK；路径可相对于本仓库，也可使用绝对路径。
PI_SDK_PATH=../ShallowCode/node_modules/@earendil-works/pi-coding-agent

# openai-completions 对应兼容 OpenAI 的 /chat/completions 接口。
# 其他支持的协议：anthropic-messages、openai-responses。
LLM_API=openai-completions
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

LLM_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0
LLM_THINKING_LEVEL=off

# 每轮预算；所有模型请求均计入上限。
AGENT_MAX_REQUESTS=40
AGENT_TIMEOUT_SECONDS=1800
